{
  "name": "kefu-rag-main",
  "version": "1.0.0",
  "description": "Customer service RAG with LlamaIndex + Elasticsearch",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "build:css": "npx @tailwindcss/cli -i ./frontend/css/tailwind.css -o ./frontend/css/styles.css --minify",
    "build:frontend": "tsc -p tsconfig.frontend.json && npm run build:css",
    "watch:css": "npx @tailwindcss/cli -i ./frontend/css/tailwind.css -o ./frontend/css/styles.css --watch",
    "test": "node --import tsx --test src/**/*.test.ts",
    "start": "node dist/index.js",
    "frontend": "npx serve frontend",
    "ingest": "tsx src/ingestion/cli.ts",
    "release:verify:local": "node --import tsx scripts/release-verify.ts local ./release-verification-local.json",
    "release:verify:production": "node --import tsx scripts/release-verify.ts production ./release-verification-production.json",
    "release:promotion-check": "node --import tsx scripts/release-promotion-check.ts",
    "release:smoke": "node --import tsx scripts/smoke-cli.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.59",
    "@elastic/elasticsearch": "^9.4.2",
    "@mastra/core": "^1.51.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "llamaindex": "^0.12.1",
    "neo4j-driver": "^6.2.0",
    "openai": "^6.46.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  }
}
